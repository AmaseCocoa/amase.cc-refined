---
import { ClientRouter } from 'astro:transitions';
import '../styles/global.css';
const { title = 'Home — Cocoa' } = Astro.props;
---
<!doctype html>
<html lang="ja">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content="Cocoa（ここあ）のプロフィール、制作物、各種リンク。" />
    <meta name="theme-color" content="#f0f9fd" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Noto+Sans+JP:wght@400;500;600;650&display=swap" rel="stylesheet" />
    <ClientRouter />
  </head>
  <body><slot /></body>
</html>
