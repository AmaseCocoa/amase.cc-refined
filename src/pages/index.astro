---
import Layout from '../layouts/Layout.astro';

const projects = [
  { name: 'apsig', language: 'Python', description: 'ActivityPubで使う署名の実装。', href: 'https://github.com/AmaseCocoa/apsig' },
  { name: 'alter', language: 'Rust', description: 'Gitのユーザー名、メールアドレス、認証情報をワンライナーで切り替えるツール。', href: 'https://github.com/AmaseCocoa/alter' },
  { name: 'libretto', language: 'Rust', description: 'pyproject.tomlのためのシンプルなタスクランナー。', href: 'https://github.com/AmaseCocoa/libretto' },
];
const links = [
  { name: 'GitHub', href: 'https://github.com/AmaseCocoa' },
  { name: 'Bluesky', href: 'https://bsky.app/profile/amase.cc' },
  { name: 'Misskey', href: 'https://misskey.io/@AmaseCocoa' },
  { name: 'amase.cc', href: 'https://amase.cc' },
];
---
<Layout>
  <a class="skip-link" href="#main">本文へ移動</a>
  <header class="header wrap">
    <a class="wordmark" href="#" aria-label="Cocoa ホーム">cocoa<span>.</span></a>
    <nav aria-label="メインナビゲーション">
      <a href="#about">About</a>
      <a href="#works">Works</a>
      <a href="#connect">Links</a>
    </nav>
  </header>
  <main id="main" class="wrap">
    <section id="about" class="hero" aria-labelledby="hero-title">
      <div class="hero-copy">
        <p class="role">Backend Developer</p>
        <h1 id="hero-title">Cocoa<span> / ここあ</span></h1>
        <p class="intro">けもみみでオタクなでべろっぱーです。</p>
        <p class="location">Tokyo, Japan</p>
        <div class="hero-links">
          <a class="button" href="#works">つくったもの</a>
          <a class="text-link" href="https://github.com/AmaseCocoa" target="_blank" rel="noreferrer">GitHub <span aria-hidden="true">↗</span></a>
        </div>
      </div>
      <img class="avatar" src="https://github.com/AmaseCocoa.png" alt="Cocoaのアバター" width="300" height="300" fetchpriority="high" />
    </section>
    <section id="works" class="section" aria-labelledby="works-title">
      <div class="section-heading">
        <h2 id="works-title">Works</h2>
        <a class="text-link" href="https://github.com/AmaseCocoa?tab=repositories" target="_blank" rel="noreferrer">すべてのリポジトリ <span aria-hidden="true">↗</span></a>
      </div>
      <div class="project-grid">
        {projects.map(project => (
          <a class="project" href={project.href} target="_blank" rel="noreferrer">
            <div class="project-heading"><h3>{project.name}</h3><span aria-hidden="true">↗</span></div>
            <p>{project.description}</p>
            <span class="language">{project.language}</span>
          </a>
        ))}
      </div>
    </section>
    <section class="blog section" aria-labelledby="blog-title">
      <div><h2 id="blog-title">Blog</h2><p>Capella</p></div>
      <a class="text-link" href="https://tw.amase.cc" target="_blank" rel="noreferrer">ブログを読む <span aria-hidden="true">↗</span></a>
    </section>
    <section id="connect" class="section" aria-labelledby="links-title">
      <h2 id="links-title">Links</h2>
      <div class="social-links">
        {links.map(link => <a href={link.href} target="_blank" rel="noreferrer">{link.name}<span aria-hidden="true">↗</span></a>)}
      </div>
    </section>
  </main>
  <footer class="wrap"><span>© {new Date().getFullYear()} Cocoa</span><a href="#">ページ上部へ ↑</a></footer>
</Layout>
