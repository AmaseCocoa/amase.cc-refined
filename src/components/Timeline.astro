---
import { timeline } from '../data/timeline';
---

<section class="content-section timeline-section" aria-labelledby="timeline-title">
  <h2 id="timeline-title">これまで</h2>
  <ol class="timeline relative list-none p-0 m-[26px_0_0_5px] max-[700px]:mt-[23px]" data-timeline>
    {timeline.map(entry => (
      <li class="milestone relative p-[0_0_32px_33px] max-[700px]:pl-7 max-[700px]:pb-[30px]">
        <span class="milestone-dot absolute z-[1] top-2 left-0 w-3 h-3 rounded-full bg-paper" aria-hidden="true" />
        <div class="milestone-content relative p-[0_0_0_3px]">
          <div class="milestone-meta flex items-center gap-3 min-h-7">
            <span class="milestone-date text-[11px] text-muted">
              <time datetime={entry.date}>{entry.date.replace('-', '.')}</time>
              {entry.endDate && <> 〜 <time datetime={entry.endDate}>{entry.endDate.replace('-', '.')}</time></>}
            </span>
            <span class="milestone-kind text-[9px] text-muted p-[0_7px] rounded-[5px]">{entry.kind}</span>
          </div>
          <h3>{entry.title}</h3>
          {entry.description && <p>{entry.description}</p>}
          {entry.href && <a href={entry.href}>{entry.linkLabel ?? '詳しく見る'} <span aria-hidden="true">↗</span></a>}
        </div>
      </li>
    ))}
  </ol>
</section>

<style>
@reference "../styles/global.css";

.timeline {
  --track-top: 14px;
  --track-height: calc(100% - 100px);
  --progress: 1;
}
.timeline::before,
.timeline::after {
  @apply absolute top-[var(--track-top)] left-[5px] w-[2px] h-[var(--track-height)] rounded-[2px] bg-outline;
  content: '';
  transform-origin: top;
}
.timeline::after {
  @apply bg-primary;
  transform: scaleY(var(--progress));
}
.milestone:last-child {
  @apply pb-0;
}
.milestone-dot {
  border: 2px solid var(--primary);
}
time {
  @apply text-primary text-[12px] font-semibold;
}
.milestone-kind {
  border: 1px solid var(--outline);
}
h3 {
  @apply text-[14px] font-semibold leading-[1.8] m-[8px_0_5px];
}
p {
  @apply text-muted text-[11px] leading-[1.9] m-0;
}
.milestone-content a {
  @apply text-primary text-[10px] inline-flex items-center gap-[13px] min-h-9 mt-1;
  text-decoration-style: dashed;
}
.milestone-content a span {
  transition: translate .3s var(--ease);
}
.milestone-content a:hover span {
  translate: 2px -2px;
}
[data-motion='true'] .milestone-dot {
  border-color: var(--outline);
  transition: background .3s, border-color .3s, box-shadow .4s;
}
[data-motion='true'] .milestone-content {
  translate: 8px 0;
  transition: translate .65s var(--ease);
}
[data-motion='true'] .is-reached .milestone-dot {
  @apply bg-primary;
  border-color: var(--primary);
  box-shadow: 0 0 0 5px var(--primary-container);
}
[data-motion='true'] .is-reached .milestone-content {
  translate: 0 0;
}
@media (max-width: 700px) {
  h3 {
    @apply text-[13px];
  }
}
@media (prefers-reduced-motion: reduce) {
  .timeline::after {
    transform: none;
  }
  [data-motion='true'] .milestone-content {
    translate: none;
  }
}
</style>

<script>
  const motion = window.matchMedia('(prefers-reduced-motion: reduce)');
  let dispose = () => {};

  function setupTimeline() {
    dispose();
    const timeline = document.querySelector<HTMLOListElement>('[data-timeline]');
    if (!timeline) return;
    const items = [...timeline.querySelectorAll<HTMLElement>('.milestone')];
    const dots = [...timeline.querySelectorAll<HTMLElement>('.milestone-dot')];
    if (!dots.length) return;
    const controller = new AbortController();
    let frame = 0;

    function update() {
      frame = 0;
      if (!timeline) return;
      const bounds = timeline.getBoundingClientRect();
      const points = dots.map(dot => {
        const rect = dot.getBoundingClientRect();
        return rect.top + rect.height / 2;
      });
      const start = points[0];
      const length = points[points.length - 1] - start;
      const readingLine = window.innerHeight * 0.64;
      const progress = motion.matches ? 1 : Math.max(0, Math.min(1, (readingLine - start) / Math.max(length, 1)));

      timeline.dataset.motion = String(!motion.matches);
      timeline.style.setProperty('--track-top', `${start - bounds.top}px`);
      timeline.style.setProperty('--track-height', `${length}px`);
      timeline.style.setProperty('--progress', String(progress));
      items.forEach((item, i) => item.classList.toggle('is-reached', motion.matches || points[i] <= readingLine));
    }

    function scheduleUpdate() {
      if (!frame) frame = requestAnimationFrame(update);
    }

    window.addEventListener('scroll', scheduleUpdate, { passive: true, signal: controller.signal });
    window.addEventListener('resize', scheduleUpdate, { signal: controller.signal });
    motion.addEventListener('change', scheduleUpdate, { signal: controller.signal });
    const resizeObserver = new ResizeObserver(scheduleUpdate);
    resizeObserver.observe(timeline);
    update();
    dispose = () => {
      controller.abort();
      resizeObserver.disconnect();
      cancelAnimationFrame(frame);
    };
  }

  document.addEventListener('astro:page-load', setupTimeline);
  document.addEventListener('astro:before-swap', () => dispose());
</script>
