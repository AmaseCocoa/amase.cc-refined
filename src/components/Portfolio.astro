---
import Sidebar from './Sidebar.astro';
import { navigation, descriptions, type Page } from '../data/navigation';

interface Props {
  page?: Page;
}

const { page = 'home' } = Astro.props;
const title = navigation.find(item => item.id === page)?.label ?? 'Home';
const description = descriptions[page];
const slide = {
  old: { name: 'page-out', duration: '220ms', easing: 'ease-in', fillMode: 'both' },
  new: { name: 'page-in', duration: '380ms', easing: 'cubic-bezier(.2,.8,.2,1)', fillMode: 'both' },
};
---

<a class="skip-link fixed z-[10] top-[10px] left-[10px] p-[10px_20px] bg-primary-container rounded-[12px]" href="#main">本文へスキップ</a>
<div class="site-shell grid grid-cols-[220px_minmax(0,_1fr)] gap-9 w-[min(1120px,_calc(100%_-_80px))] m-[40px_auto] items-start min-[1400px]:mt-16 max-[900px]:w-[calc(100%_-_48px)] max-[900px]:grid-cols-[190px_minmax(0,_1fr)] max-[900px]:gap-6 max-[900px]:mt-[26px] max-[700px]:block max-[700px]:w-[calc(100%_-_32px)] max-[700px]:m-[0_auto_16px]">
  <Sidebar page={page} />

  <div class="main-column min-w-0 p-[0_34px] bg-paper rounded-[22px] max-[900px]:px-[26px] max-[700px]:rounded-[18px] max-[700px]:px-6 max-[360px]:px-[19px]">
    <header class="topbar flex justify-between items-center min-h-[65px] text-[11px] text-muted max-[700px]:min-h-[54px] max-[700px]:text-[10px]"><a href="/">amase.cc</a><span>/ {title}</span></header>
    <main id="main" tabindex="-1" transition:name="content" transition:animate={{ forwards: slide, backwards: slide }}>
      <header class="page-heading mb-[34px] max-[700px]:mb-[29px]">
        <h1>{title}</h1>
        <p>{description}</p>
      </header>

      <slot />
    </main>
    <footer class="site-footer flex items-center justify-between gap-4 p-[20px_0_23px] text-[9px] text-muted max-[700px]:text-[9px]"><span>© {new Date().getFullYear()} Cocoa</span><a href="#main">先頭へ <span aria-hidden="true">↑</span></a></footer>
  </div>
</div>

<script>
  import '../scripts/reveal';
</script>
