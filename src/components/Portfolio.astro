---
const { page = 'home' } = Astro.props;
const navigation = [
  { id: 'home', url: '/', label: 'Home' },
  { id: 'skills', url: '/skills/', label: 'Skills' },
  { id: 'works', url: '/works/', label: 'Works' },
];
const title = navigation.find(item => item.id === page)?.label ?? 'Home';
const description = {
  home: '多分色々なことをしています！',
  skills: '実はこんなことができます',
  works: '作ったものがあるのかも',
}[page as 'home' | 'skills' | 'works'];
const social = [
  { name: 'X', url: 'https://x.com/mocha_amase' },
  { name: 'Misskey', url: 'https://msk.amase.cc/@cocoa' },
  { name: 'GitHub', url: 'https://github.com/AmaseCocoa' },
  { name: 'Qiita', url: 'https://qiita.com/AmaseCocoa' },
];
const skills = [
  { title: 'Frontend', items: ['TypeScript', 'Tailwind CSS', 'Astro', 'Vue'] },
  { title: 'Backend', items: ['TypeScript', 'Express', 'Python', 'Go', 'Rust', 'ActivityPub'] },
  { title: 'Misc', items: ['Arch Linux', 'Linux', 'Git'] },
];
const slide = {
  old: { name: 'page-out', duration: '220ms', easing: 'ease-in', fillMode: 'both' },
  new: { name: 'page-in', duration: '380ms', easing: 'cubic-bezier(.2,.8,.2,1)', fillMode: 'both' },
};
---

<a class="skip-link" href="#main">本文へスキップ</a>
<div class="site-shell">
  <aside class="sidebar" aria-label="プロフィールとナビゲーション">
    <a class="identity" href="/" aria-label="Cocoa ホーム" transition:name="identity">
      <img src="https://github.com/AmaseCocoa.png" alt="" width="64" height="64" />
      <div>
        <span class="identity-name">Cocoa</span>
        <span class="identity-role">Backend Developer</span>
      </div>
    </a>

    <nav class="social-links" aria-label="SNS">
      {social.map(({ name, url }) => <a href={url}>{name}</a>)}
    </nav>

    <nav class="global-nav" aria-label="メインナビゲーション">
      {navigation.map(({ id, url, label }) => (
        <a href={url} aria-current={page === id ? 'page' : undefined}>
          <span aria-hidden="true">/</span> {label}
          <span class="nav-arrow" aria-hidden="true">→</span>
        </a>
      ))}
    </nav>

    <a class="blog-link" href="https://tw.amase.cc">ブログを読む <span aria-hidden="true">↗</span></a>
    <a class="site-address" href="/">amase.cc</a>
  </aside>

  <div class="main-column">
    <header class="topbar"><a href="/">amase.cc</a><span>/ {title}</span></header>
    <main id="main" tabindex="-1" transition:name="content" transition:animate={{ forwards: slide, backwards: slide }}>
      <header class="page-heading">
        <h1>{title}</h1>
        <p>{description}</p>
      </header>

      {page === 'home' && (
        <>
          <section class="content-section reveal" aria-labelledby="now-title">
            <h2 id="now-title">最近していること</h2>
            <ul class="activity-list">
              <li><span class="list-marker" aria-hidden="true">−</span><div>インフラ</div></li>
              <li><span class="list-marker" aria-hidden="true">−</span><div>プログラミング<p>インフラにはまってあんまりしてない</p></div></li>
            </ul>
          </section>

          <section class="content-section reveal" aria-labelledby="articles-title">
            <div class="section-heading"><h2 id="articles-title">最近の記事</h2><a href="https://tw.amase.cc" class="subtle-link">ブログへ <span aria-hidden="true">↗</span></a></div>
            <div class="recent-articles" data-feed aria-live="polite" aria-busy="true">
              <p class="feed-status" data-feed-status>記事を読み込んでいます…</p>
              <ul class="article-list" data-feed-list hidden />
              <button type="button" class="retry-button" data-feed-retry hidden>もう一度読み込む</button>
            </div>
            <noscript><p class="feed-status">最近の記事は<a href="https://tw.amase.cc">ブログ</a>から読めます。</p></noscript>
          </section>

          <section class="content-section reveal" aria-labelledby="links-title">
            <h2 id="links-title">Links</h2>
            <p>バナーを募集してるかもしれないとか…</p>
            <div class="recommendations">
              <h3>おすすめのリンク</h3>
              <p>とにかくおすすめのリンクを貼るだけのセクションです（順次追加）</p>
              <ul><li><a href="https://www.youtube.com/@KoshiraiSofuto">おすすめ1 <span aria-hidden="true">↗</span></a><span class="recommendation-note">：<s>けもみみ！！！！！！！！！！！！！！！！！！！！</s></span></li></ul>
            </div>
          </section>
        </>
      )}

      {page === 'skills' && skills.map(({ title: group, items }) => (
        <section class="content-section reveal">
          <h2>{group}</h2>
          <ul class="skill-list">{items.map(item => <li>{item}</li>)}</ul>
        </section>
      ))}

      {page === 'works' && (
        <section class="project-section reveal" aria-label="制作物">
          <article class="project">
            <div class="project-heading"><h2>anylink</h2><time datetime="2026-08">2026.08</time></div>
            <p>Cloudflare Workersを活用したリンク共有サービス</p>
            <ul class="project-tags" aria-label="技術・担当"><li>backend</li><li>serverless</li><li>nuxt</li></ul>
            <a class="project-link" href="https://anylink.amase.cc">サイトを見る <span aria-hidden="true">↗</span></a>
          </article>
        </section>
      )}
    </main>
    <footer class="site-footer"><span>© {new Date().getFullYear()} Cocoa</span><a href="#main">先頭へ <span aria-hidden="true">↑</span></a></footer>
  </div>
</div>

<script>
  const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
  let cleanup = () => {};

  function setupPage() {
    cleanup();
    const controller = new AbortController();
    const animations: Animation[] = [];
    const observer = new IntersectionObserver(entries => {
      for (const entry of entries) {
        if (!entry.isIntersecting) continue;
        if (!reducedMotion.matches) {
          animations.push(entry.target.animate(
            [{ opacity: 0, transform: 'translateY(12px)' }, { opacity: 1, transform: 'translateY(0)' }],
            { duration: 500, easing: 'cubic-bezier(.2,.8,.2,1)' },
          ));
        }
        observer.unobserve(entry.target);
      }
    }, { threshold: 0.1 });
    document.querySelectorAll('.reveal').forEach(element => observer.observe(element));

    const feed = document.querySelector<HTMLElement>('[data-feed]');
    const status = feed?.querySelector<HTMLElement>('[data-feed-status]');
    const list = feed?.querySelector<HTMLUListElement>('[data-feed-list]');
    const retry = feed?.querySelector<HTMLButtonElement>('[data-feed-retry]');

    async function loadArticles() {
      if (!feed || !status || !list || !retry) return;
      feed.setAttribute('aria-busy', 'true');
      status.hidden = false;
      status.textContent = '記事を読み込んでいます…';
      retry.hidden = true;
      list.hidden = true;
      try {
        const response = await fetch(
          'https://rawcdn.githack.com/AmaseCocoa/AmaseCocoa/30ec3b086df24d8b7548d3b1f588412a2015f3fe/feeds.json',
          { signal: AbortSignal.any([controller.signal, AbortSignal.timeout(8000)]) },
        );
        if (!response.ok) throw new Error('Feed unavailable');
        const data: unknown = await response.json();
        if (!Array.isArray(data)) throw new Error('Invalid feed');
        const entries: HTMLLIElement[] = [];
        for (const article of data) {
          if (!article || typeof article !== 'object') continue;
          if (typeof article.title !== 'string' || typeof article.link !== 'string') continue;
          let url: URL;
          try { url = new URL(article.link); } catch { continue; }
          if (url.protocol !== 'https:') continue;
          const item = document.createElement('li');
          const link = document.createElement('a');
          const heading = document.createElement('span');
          const domain = document.createElement('span');
          const arrow = document.createElement('span');
          link.href = url.href;
          heading.textContent = article.title;
          heading.className = 'article-title';
          domain.textContent = url.hostname;
          domain.className = 'article-domain';
          arrow.textContent = '↗';
          arrow.className = 'article-arrow';
          arrow.setAttribute('aria-hidden', 'true');
          link.append(heading, domain, arrow);
          item.append(link);
          entries.push(item);
        }
        list.replaceChildren(...entries);
        list.hidden = entries.length === 0;
        status.hidden = entries.length > 0;
        if (!entries.length) status.textContent = '記事はまだありません。';
      } catch {
        if (controller.signal.aborted) return;
        status.textContent = '記事を読み込めませんでした。ブログからも読めます。';
        retry.hidden = false;
      } finally {
        if (!controller.signal.aborted) feed.setAttribute('aria-busy', 'false');
      }
    }

    retry?.addEventListener('click', loadArticles, { signal: controller.signal });
    if (feed) void loadArticles();

    const stopAnimations = () => {
      if (reducedMotion.matches) animations.forEach(animation => animation.cancel());
    };
    reducedMotion.addEventListener('change', stopAnimations, { signal: controller.signal });
    cleanup = () => {
      controller.abort();
      observer.disconnect();
      animations.forEach(animation => animation.cancel());
    };
  }

  document.addEventListener('astro:page-load', setupPage);
  document.addEventListener('astro:before-swap', () => cleanup());
</script>
